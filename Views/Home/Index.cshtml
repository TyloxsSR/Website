    <div class="edu-grid">
        <div class="edu-card">
            <img src="/img/muller.png" alt="Muller Elementary">

            <h2>Elementary</h2>

            <p>@Model.ElementaryBio</p>
        </div>

        <div class="edu-card">
            <img src="/img/davidson.png" alt="Davidson Middle">

            <h2>Middle</h2>

            <p>@Model.MiddleBio</p>
        </div>

        <div class="edu-card">
            <img src="/img/alonso.png" alt="Alonso High">

            <h2>High</h2>

            <p>@Model.HighBio</p>
        </div>
    </div>

    
</section>


<section class="hobbies">

    <!-- Header -->
    <h1 class="hobbyHeader">Hobbies</h1>

    <!-- Bio -->
    <p class="speedrunner-bio">
        @Model.SpeedrunnerBio
    </p>

    <!-- Grid of hobby items -->
    <div class="hobby-grid">

        <!-- God of War -->
        <div class="hobby-item">
            <img src="/img/gow.png" alt="God of War Speedrun">

            <div class="records">
                <table>
                    <thead>
                        <tr>
                            <th>Game</th>
                            <th>Category</th>
                            <th>Time</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>@Model.GameName[0]</td>
                            <td>@Model.Category[0]</td>
                            <td>@Model.GodOfWarRecords[0]</td>
                            <td>March 7, 2019</td>
                            <td>Personal Best</td>
                        </tr>
                        <tr>
                            <td>@Model.GameName[0]</td>
                            <td>@Model.Category[0]</td>
                            <td>@Model.GodOfWarRecords[1]</td>
                            <td>Unknown</td>
                            <td>Personal Best</td>
                        </tr>
                        <tr>
                            <td>@Model.GameName[0]</td>
                            <td>@Model.Category[0]</td>
                            <td>@Model.GodOfWarRecords[2]</td>
                            <td>April 6, 2019</td>
                            <td>World Record + Personal Best</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Days Gone -->
        <div class="hobby-item">
            <img src="/img/daysgone.png" alt="Days Gone Speedrun">

            <div class="records">
