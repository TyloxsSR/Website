@model Website.Models.AboutMeModel

<!DOCTYPE html>
<!---->
<html lang="us">
<head>
    <meta charset="utf-8">
    <meta name="author" content="Tyler Durham">
    <meta name="description" content="This is a simple site I made to test my Web Dev skills!">
    <title>Tyler's Domain</title>
    <link rel="icon" href="icon.png" type="image/x-icon"> <!--This builds the icon for the tab for your website!-->
    <link rel="stylesheet" href="~/css/Home.css" type="text/css">
    <script src="~/js/Specs.js"></script>
    <script src="~/js/portfolio.js"></script>
</head>

<html>
    <!--SHOOTING STAR-->
<div class="shooting-star"></div>
<div class="shooting-star delay-1"></div>
<div class="shooting-star delay-2"></div>
<div class="shooting-star delay-3"></div>
<!--Image-->
<div class="hero">
    <img class="portrait" src="/img/portrait.png" alt="A picture of me!">

    <div class="about">
        <h2>About Me</h2>
        <p>Age: @Model.MyAge</p>
        <p>Self Taught Programmer (WIP)</p>
        <p>Years in learning: @Model.DeveloperAge</p>

        <div class="button-row">
            <button class="btn" onclick="PortfolioLink(this)" value="https://localhost:7256/portfolio">Portfolio</button>
            <button class="btn" onclick="SpecsLink(this)" value="https://localhost:7256/specs">PC Setup</button>
        </div>
    </div>
</div>


    <!---Education--->
<section class="education">
    <h1>Education</h1>

    @* <div class="edu-grid">
        <div class="edu-card">
            <h2>Elementary</h2>
            <p>@Model.ElementaryBio</p>
        </div>

        <div class="edu-card">
            <h2>Middle</h2>
            <p>@Model.MiddleBio</p>
